# Optional outbound-link attribution. When set, external links receive this
# value as their `utm_source`; leave it empty to keep URLs unchanged.
# 可选的外部链接来源标记。配置后会把该值写入外链的 `utm_source`；
# 留空时保持原始 URL，不追加 UTM 参数。
NEXT_PUBLIC_UTM_SOURCE=

# Optional analytics integrations. Each provider is enabled only when its
# public identifier is configured; unconfigured providers remain disabled.
# 可选的访问统计集成。只有配置对应的公开标识后才会启用；
# 未配置的统计服务会保持关闭。
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# GoatCounter: set your hosted account URL, for example https://example.goatcounter.com.
# GoatCounter：填写托管账户地址，例如 https://example.goatcounter.com。
NEXT_PUBLIC_GOATCOUNTER_URL=
